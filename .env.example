# Copy to .env.local and fill in. Everything except Firebase is optional:
# the app falls back gracefully (heuristic parser, tag matching, template
# Calendar links, in-app-only notifications) when a key is missing.

# --- Firebase (required) ---
# Console > Project settings > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Console > Project settings > Service accounts > Generate new private key
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the key on one line with literal \n sequences, wrapped in double quotes
FIREBASE_ADMIN_PRIVATE_KEY=

# --- LLM (optional; without a key the deterministic fallback parser/ranker is used) ---
LLM_PROVIDER=gemini            # or claude
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite  # Gemini: falls back to other Flash models if busy. Claude: e.g. claude-opus-5-5
EMBEDDING_MODEL=gemini-embedding-001

# --- Email via Gmail SMTP (optional; requires 2-Step Verification + App Password) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Google Calendar + Meet (optional; falls back to a Calendar template link) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/callback

NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Seed / demo accounts (used by `npm run seed`) ---
# These Google accounts become admins of the demo host and the "perfect partner" club on first login.
DEMO_HOST_EMAIL=vaibhav.04816401525@std.ggsipu.ac.in
DEMO_PARTNER_EMAIL=rohan.01916401525@std.ggsipu.ac.in
